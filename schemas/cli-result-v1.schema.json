{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vector-png Editor operational CLI result v1",
  "type": "object",
  "required": ["protocol", "command", "request_id", "ok"],
  "properties": {
    "protocol": {"const": 1},
    "command": {"enum": ["inspect", "extract", "validate", null]},
    "request_id": {"type": ["string", "null"], "maxLength": 128},
    "ok": {"type": "boolean"},
    "result": {"type": "object"},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["invalid-arguments", "invalid-container", "invalid-svg", "unsupported-profile", "resource-limit", "ordinary-png", "io-error", "output-exists", "render-failed", "render-timeout"]},
        "message": {"type": "string", "maxLength": 2000}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"properties": {"ok": {"const": true}}, "required": ["result"], "not": {"required": ["error"]}},
    {"properties": {"ok": {"const": false}}, "required": ["error"], "not": {"required": ["result"]}}
  ],
  "additionalProperties": false
}
