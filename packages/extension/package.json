{
  "name": "vector-png-editor",
  "displayName": "Vector PNG Editor",
  "description": "Edit PNG files with an embedded safe-svg-v1 SVG source.",
  "version": "0.1.0-dev0",
  "private": true,
  "publisher": "makotosan",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=24"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:vectorPng.editor",
    "onCommand:vectorPng.openInEditor",
    "onCommand:vectorPng.newDocument",
    "onCommand:vectorPng.setupEnvironment",
    "onCommand:vectorPng.environmentStatus",
    "onCommand:vectorPng.rollbackEnvironment"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "check": "tsc -p .",
    "test": "node --test tests/*.test.mjs",
    "bundle:monaco": "node scripts/copy-monaco.mjs",
    "vscode:prepublish": "node scripts/copy-monaco.mjs && node scripts/copy-schemas.mjs",
    "bundle:schemas": "node scripts/copy-schemas.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/vscode": "1.90.0",
    "typescript": "5.9.3"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "vectorPng.editor",
        "displayName": "Vector PNG Editor",
        "selector": [
          {
            "filenamePattern": "*.png"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "vectorPng.openInEditor",
        "title": "Vector PNG: Open in Editor"
      },
      {
        "command": "vectorPng.newDocument",
        "title": "Vector PNG: New Document"
      },
      {
        "command": "vectorPng.setupEnvironment",
        "title": "Vector PNG: Set Up Python Environment"
      },
      {
        "command": "vectorPng.environmentStatus",
        "title": "Vector PNG: Python Environment Status"
      },
      {
        "command": "vectorPng.rollbackEnvironment",
        "title": "Vector PNG: Roll Back Python Environment"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vectorPng.openInEditor",
          "when": "resourceExtname == .png",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vectorPng.openInEditor"
        },
        {
          "command": "vectorPng.newDocument"
        }
      ]
    },
    "configuration": {
      "title": "Vector PNG Editor",
      "properties": {
        "vectorPng.corePythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a Python 3.11-3.13 executable with the vector-png-editor Core installed. Takes precedence over the managed environment (see 'Vector PNG: Set Up Python Environment'). Leave empty to use the managed environment."
        },
        "vectorPng.coreWheelPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a trusted vector_png_editor_core wheel used by 'Vector PNG: Set Up Python Environment' when no bundled wheel is present."
        }
      }
    }
  },
  "dependencies": {
    "monaco-editor": "0.57.0"
  }
}
